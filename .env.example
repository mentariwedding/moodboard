# ============================================================
# KONFIGURASI SUPABASE (opsional)
# Kalau 2 variabel ini KOSONG, aplikasi jalan dalam MODE DEMO
# (data hanya tersimpan di browser, cocok untuk mencoba).
#
# Cara dapat nilai ini:
# 1. Buat proyek gratis di https://supabase.com
# 2. Buka Project Settings > API
# 3. Salin Project URL dan anon public key ke sini
# 4. Jalankan isi supabase/schema.sql di SQL Editor
# ============================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Prefix tabel & bucket — supaya aman berbagi satu proyek Supabase dengan aplikasi lain.
# Default: mw_ (tabel jadi mw_projects, mw_moodboards; bucket mw_references).
# Jika diubah, tabel di supabase/schema.sql juga harus disesuaikan sebelum dijalankan.
VITE_DB_PREFIX=mw_

# Kode rahasia untuk mendaftarkan akun WO (opsional).
# Kosongkan kalau akun dibuat manual dari Dashboard Supabase > Authentication > Users.
VITE_WO_SIGNUP_CODE=

# Kode kunci dashboard MODE DEMO (saat Supabase belum dikonfigurasi).
# Default: 1234. Di mode Supabase, dashboard memakai login email, variabel ini diabaikan.
VITE_DEMO_PIN=1234
